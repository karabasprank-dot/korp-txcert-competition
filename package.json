{
  "name": "korp-txcert-competition",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "check": "npm run sdk:build && npm run typecheck && npm run lint && npm test",
    "sdk:build": "node --import tsx scripts/build-sdk.ts",
    "demo:competition": "node --import tsx scripts/hackathon/demo.ts && python3 scripts/hackathon/build-viewer.py",
    "demo:chain": "node --import tsx scripts/hackathon/local-chain.ts",
    "pay:testnet": "node --import tsx scripts/pay-testnet.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "pilot:testnet": "node --import tsx scripts/pilot/run-base-sepolia.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@x402/core": "2.26.0",
    "@x402/evm": "2.26.0",
    "@x402/extensions": "2.26.0",
    "@x402/fetch": "2.26.0",
    "@x402/hono": "2.26.0",
    "hono": "4.13.8",
    "viem": "2.56.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260916.1",
    "@eslint/js": "10.0.1",
    "@foundry-rs/anvil": "1.7.1",
    "@types/node": "22.20.3",
    "@vitest/coverage-v8": "5.0.1",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1",
    "wrangler": "4.132.0"
  }
}
